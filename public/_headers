/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/og.png
  Cache-Control: public, max-age=86400, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The HTML and its two shared assets must revalidate together. Without this the
# browser happily pairs a fresh page with a cached stylesheet from a previous
# deploy, which renders as an unstyled or half-styled site and looks exactly
# like a CSS bug. Caught in the wild on 24 Aug 2026.
/site.css
  Cache-Control: public, max-age=0, must-revalidate
/site.js
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
