{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keep-austin-colorful",
  "compatibility_date": "2026-08-08",

  // The site is static; the worker exists only to serve /api/district, because
  // the Census geocoder returns 503 to browser-origin requests. Everything
  // else falls through to the assets via the ASSETS binding.
  "main": "src/worker.js",

  // Only ./public ships. Everything else — tests, docs, the og-image source,
  // node_modules — stays out of the deploy. Without this pin Wrangler defaults
  // to the repo root and tries to upload jsdom's 122 MiB workerd binary as a
  // static asset, against a 25 MiB limit.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // The apex is bound here rather than only in the dashboard. A dashboard-only
  // binding is invisible to the repo, and losing it takes the whole site down
  // while the edge cache keeps serving stale HTML, so the failure looks like a
  // CSS bug rather than an unrouted hostname.
  "routes": [
    { "pattern": "keepaustincolorful.com", "custom_domain": true }
  ],

  // Keep the *.workers.dev URL alive. It is not the public address, but it is
  // the only way to reach the Worker without going through the zone, which is
  // what you need when diagnosing a DNS or routing problem. Wrangler disables
  // it by default whenever this key is absent.
  "workers_dev": true,

  "observability": { "enabled": true }
}
